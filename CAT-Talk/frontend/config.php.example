         * This specifies the DB connection arguments
         * @param string    $host URL for the DB (or if docker it is 'postgres')
         * @param string    $name Name of the database
         * @param string    $user Username for the DB
         * @param string    $pass Password for the DB
         * @param int       $port Port for the DB
         */
        'postgres' => [
            'host'              => 'postgres', // Hostname of Postgres DB. 'postgres' refers to the Docker service name set in docker-compose.yml that this container can reach
            'name'              => '',         // Name of Postgres DB. Set in .env
            'user'              => '',         // Username for Postgres DB. Set in .env
            'pass'              => '',         // Password for Postgres DB. Set in .env
            'port'              => 5432        // Postgres port internal to docker container, change in docker-compose.yml
        ],
        /**
         * Authenticate users with CiLogon (https://cilogon.org/oauth2/register)
         * @param string        $clientId generated from CiLogon
