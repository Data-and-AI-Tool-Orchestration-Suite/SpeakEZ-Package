-- Create plugins table
CREATE TABLE IF NOT EXISTS plugins(
    id INT NOT NULL PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    display_name VARCHAR(255) NOT NULL,
    description TEXT,
    active BOOLEAN NOT NULL DEFAULT FALSE
);

