BEGIN;
-- Create projects table
CREATE TABLE IF NOT EXISTS projects(
    id VARCHAR(36) NOT NULL PRIMARY KEY,
    owner_id VARCHAR(36),
    tenant_id VARCHAR(36) NOT NULL REFERENCES tenants(id) ON DELETE CASCADE ON UPDATE CASCADE,
    name TEXT,
    members JSON,
    CONSTRAINT projects_owner_fk FOREIGN KEY (owner_id) REFERENCES users(id) ON DELETE SET NULL
);

-- Create collection_codes table
CREATE TABLE IF NOT EXISTS collection_codes(
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    code VARCHAR(255) UNIQUE NOT NULL,
    project_id VARCHAR(36) NOT NULL REFERENCES projects(id) ON DELETE CASCADE
);

COMMIT;

BEGIN;
-- Create files table
CREATE TABLE IF NOT EXISTS files(
    id CHAR(36) NOT NULL PRIMARY KEY,
    collection_code_id UUID NOT NULL REFERENCES collection_codes(id) ON DELETE CASCADE,
    filename TEXT NOT NULL,
    transcription_filename TEXT DEFAULT NULL,
    izers JSON NOT NULL,
    date_added TIMESTAMP NOT NULL DEFAULT NOW(),
    archived JSON NOT NULL,
    status JSON NOT NULL,
    file_type VARCHAR(36),
    associated_project_id VARCHAR(36) REFERENCES projects(id) ON DELETE SET NULL
);

COMMIT;

BEGIN;
CREATE TABLE jobs (
    job_id SERIAL PRIMARY KEY,
    file_id CHARACTER(36) REFERENCES files(id) ON DELETE CASCADE,
    job_name TEXT NOT NULL,  -- No space restriction
    system_prompt TEXT NOT NULL,
    user_prompt TEXT NOT NULL,
    output_format TEXT,
    combine BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMP DEFAULT NOW()
);




CREATE TABLE job_defaults (
    job_name TEXT PRIMARY KEY,
    system_prompt TEXT NOT NULL,
    user_prompt TEXT NOT NULL,
    output_format TEXT,
    combine BOOLEAN DEFAULT FALSE
);


INSERT INTO job_defaults (job_name, system_prompt, user_prompt, output_format, combine)
VALUES (
    'riskalyzer',
    'You are a helpful assistant',
    'Extract sensitive content from this portion of a transcript. Sensitive content only includes racism, sexual content, defamation, libel, slander, and other types of content related to OTHER people. The person being interviewed is allowed to share personal information, and that content should not be flagged. List the line number, why the content is considered sensitive, and the excerpt of sensitive content. Do not say if part of the conversation appears to be missing, and do not output anything extra. Look at your conversation history and add on to the previous report if you think that the part of the transcript you are looking at is a continuation of that. Only output information in this format:
time_codes: [10:00:01 - 10:00:08]
reason: The reason the content is considered sensitive
excerpt: A long excerpt from the text.
Say nothing else at all.',
    '',
    FALSE
)
ON CONFLICT (job_name) DO UPDATE
SET system_prompt = EXCLUDED.system_prompt,
    user_prompt = EXCLUDED.user_prompt,
    output_format = EXCLUDED.output_format,
    combine = EXCLUDED.combine;

COMMIT;

BEGIN;
-- Create metrics table
CREATE TABLE IF NOT EXISTS metrics(
    task_id VARCHAR(36) PRIMARY KEY,
    details JSONB,
    user_id VARCHAR(36),
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE TABLE IF NOT EXISTS llm_conversations (
    id SERIAL PRIMARY KEY,
    file_id VARCHAR(255) NOT NULL,
    convo_name VARCHAR(255) NOT NULL,
    model VARCHAR(100) NOT NULL,
    messages JSONB NOT NULL DEFAULT '[]',
    created_at TIMESTAMP WITH TIME ZONE DEFAULT now()
);

CREATE TABLE IF NOT EXISTS site_banner (
    is_on BOOLEAN NOT NULL DEFAULT FALSE,
    message TEXT
);

CREATE TABLE IF NOT EXISTS file_duration (
    id SERIAL PRIMARY KEY,
    file_id CHAR(36) NOT NULL REFERENCES files(id) ON DELETE CASCADE,
    duration_seconds DOUBLE PRECISION NOT NULL,
    created_at TIMESTAMP WITHOUT TIME ZONE DEFAULT now(),
    updated_at TIMESTAMP WITHOUT TIME ZONE DEFAULT now()
);

CREATE UNIQUE INDEX IF NOT EXISTS idx_file_duration_file_id ON file_duration(file_id);

COMMIT;
