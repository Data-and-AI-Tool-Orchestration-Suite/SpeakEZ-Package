-- ============================================================
-- SpeakEZ database initialization.
-- Runs automatically on the FIRST start of the database container.
-- The admin email (<ADMIN_EPPN>) is filled in automatically from
-- the ADMIN_EPPN value in the .env file when the container is
-- built — no editing needed here.
-- ============================================================

BEGIN;

-- Create user roles table
CREATE TABLE IF NOT EXISTS user_roles(
    role_id INT NOT NULL PRIMARY KEY,
    role_name VARCHAR(255) NOT NULL
);

-- Create users table for CiLogon
CREATE TABLE IF NOT EXISTS users(
    id VARCHAR(255) NOT NULL PRIMARY KEY,
    email VARCHAR(255),
    first_name VARCHAR(255),
    last_name VARCHAR(255),
    full_name VARCHAR(255),
    eppn VARCHAR(255),
    idp VARCHAR(255),
    idp_name VARCHAR(255),
    affiliation VARCHAR(255),
    roles INT[] DEFAULT ARRAY[0],
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- Create user_sessions table
CREATE TABLE IF NOT EXISTS user_sessions(
    session_id VARCHAR(36) NOT NULL PRIMARY KEY,
    user_id VARCHAR(255) NOT NULL,
    expires TIMESTAMP NOT NULL,
    token JSONB NOT NULL,
    CONSTRAINT user_sessions_users_id_fk FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE CASCADE ON UPDATE CASCADE
);

-- Create users_accepted_agreement table
CREATE TABLE IF NOT EXISTS users_accepted_agreement(
    user_id VARCHAR(36) NOT NULL PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE ON UPDATE CASCADE
);

COMMIT;

BEGIN;

-- Insert predefined roles
INSERT INTO user_roles (role_id, role_name) VALUES
    (0, 'Default'),
    (1, 'Admin'),
    (2, 'User'),
    (3, 'SpeakEZ_User')
ON CONFLICT (role_id) DO NOTHING;

-- Constraint to ensure roles are valid
CREATE OR REPLACE FUNCTION check_roles_validity()
RETURNS TRIGGER AS $$
BEGIN
    IF EXISTS (
        SELECT 1 FROM unnest(NEW.roles) AS role_id
        WHERE role_id NOT IN (SELECT role_id FROM user_roles)
    ) THEN
        RAISE EXCEPTION 'Invalid role_id in roles array';
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE TRIGGER validate_roles
BEFORE INSERT OR UPDATE ON users
FOR EACH ROW EXECUTE FUNCTION check_roles_validity();

COMMIT;

BEGIN;
-- Insert initial Admin user (replace <ADMIN_EPPN> dynamically)
INSERT INTO users (id, eppn, roles) VALUES
    ('notloggedin_admin_user_id', '<ADMIN_EPPN>', ARRAY[(SELECT role_id FROM user_roles WHERE role_name = 'Admin')])
ON CONFLICT (id) DO NOTHING;

COMMIT;


BEGIN;

-- Create tenants table
CREATE TABLE IF NOT EXISTS tenants(
	id VARCHAR(36) PRIMARY KEY NOT NULL,
	name TEXT NOT NULL,
    can_self_manage BOOLEAN DEFAULT FALSE
);

-- Create tenant_roles table
CREATE TABLE IF NOT EXISTS tenant_roles(
    tenant_id VARCHAR(36) NOT NULL REFERENCES tenants(id)  ON UPDATE CASCADE ON DELETE CASCADE,
	role_id INT NOT NULL,
    role_name VARCHAR(255) NOT NULL,
    PRIMARY KEY(tenant_id, role_id)
);

-- Create tenant_users table
CREATE TABLE IF NOT EXISTS tenant_users(
    tenant_id VARCHAR(36),
    user_id VARCHAR(36) REFERENCES users(id) ON UPDATE CASCADE ON DELETE CASCADE,
    tenant_role INT NOT NULL,
    UNIQUE(tenant_id, user_id, tenant_role),
    PRIMARY KEY(tenant_id, user_id, tenant_role),
    CONSTRAINT fk_tenant_role FOREIGN KEY (tenant_id, tenant_role)
        REFERENCES tenant_roles(tenant_id, role_id)
        ON UPDATE CASCADE ON DELETE CASCADE
);

-- Create table to track current tenant for each user
CREATE TABLE IF NOT EXISTS users_current_tenants(
    user_id VARCHAR(36) PRIMARY KEY REFERENCES users(id) ON UPDATE CASCADE ON DELETE CASCADE,
    tenant_id VARCHAR(36) NOT NULL REFERENCES tenants(id)  ON UPDATE CASCADE ON DELETE CASCADE
);

CREATE OR REPLACE FUNCTION enforce_tenant_entry()
    RETURNS TRIGGER AS $$
BEGIN
    -- Check if the combination exists in tenant_users
    IF NOT EXISTS (
        SELECT 1 FROM tenant_users
        WHERE tenant_users.user_id = NEW.user_id
          AND tenant_users.tenant_id = NEW.tenant_id
    ) THEN
        RAISE EXCEPTION 'Invalid entry: user_id and tenant_id must exist in tenant_users';
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE TRIGGER enforce_tenant_entry_trigger
    BEFORE INSERT OR UPDATE ON users_current_tenants
    FOR EACH ROW EXECUTE FUNCTION enforce_tenant_entry();


-- Create trigger to set new current tenant if all roles removed from user's current tenant.
-- If no tenants exist, throw an exception. The user should always have a tenant, or just
-- delete the user.
CREATE OR REPLACE FUNCTION update_or_delete_current_tenant()
RETURNS TRIGGER AS $$
DECLARE
    new_tenant VARCHAR(36);
BEGIN
    -- Check if the deleted tenant was the user's current tenant
    IF EXISTS (SELECT 1 FROM users_current_tenants WHERE user_id = OLD.user_id AND tenant_id = OLD.tenant_id) THEN
        -- Check if the user still has other roles in the same tenant
        IF EXISTS (SELECT 1 FROM tenant_users WHERE user_id = OLD.user_id AND tenant_id = OLD.tenant_id) THEN
            -- User still has roles in the tenant, so do nothing
            RETURN OLD;
        END IF;
        -- Find another tenant the user is associated with
        SELECT tenant_id INTO new_tenant
        FROM tenant_users
        WHERE user_id = OLD.user_id
        LIMIT 1;
        -- If another tenant exists, update the current tenant
        IF FOUND THEN
            UPDATE users_current_tenants
            SET tenant_id = new_tenant
            WHERE user_id = OLD.user_id;
        ELSE
            -- If no other tenant exists, throw an error
            RAISE EXCEPTION 'User % has no other tenants. Cannot delete last tenant.', OLD.user_id;
        END IF;
    END IF;

    RETURN OLD;
END;
$$ LANGUAGE plpgsql;


DROP TRIGGER IF EXISTS ensure_valid_current_tenant ON tenant_users;

CREATE CONSTRAINT TRIGGER ensure_valid_current_tenant
AFTER DELETE ON tenant_users
DEFERRABLE INITIALLY DEFERRED
FOR EACH ROW
EXECUTE FUNCTION update_or_delete_current_tenant();

-- Create trigger to set current tenant if not currently set
CREATE OR REPLACE FUNCTION after_insert_tenant_user()
RETURNS TRIGGER AS $$
BEGIN
    -- If the user does not have a current tenant, set the newly inserted one
    IF NOT EXISTS (SELECT 1 FROM users_current_tenants WHERE user_id = NEW.user_id) THEN
        INSERT INTO users_current_tenants (user_id, tenant_id)
        VALUES (NEW.user_id, NEW.tenant_id);
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE TRIGGER after_insert_tenant_user_trigger
AFTER INSERT ON tenant_users
FOR EACH ROW
EXECUTE FUNCTION after_insert_tenant_user();


-- Create tenant_styles table
CREATE TABLE IF NOT EXISTS tenant_styles(
	tenant_id VARCHAR(36) PRIMARY KEY REFERENCES tenants(id) ON UPDATE CASCADE ON DELETE CASCADE,
	styles JSONB DEFAULT '{}'
);

-- Add the default tenant
INSERT INTO tenants (id, name, can_self_manage)
VALUES ('bad3c98b-e673-4547-bd3a-afe8f6fc5c68', 'University of Kentucky', true)
ON CONFLICT (id) DO NOTHING;

-- Add Admin role to the default tenant
INSERT INTO tenant_roles (tenant_id, role_id, role_name)
VALUES ('bad3c98b-e673-4547-bd3a-afe8f6fc5c68',
	(SELECT COALESCE(MAX(role_id), -1)+1 as new_role_id
	FROM tenant_roles
	WHERE tenant_id = 'bad3c98b-e673-4547-bd3a-afe8f6fc5c68'),
	'Admin');

-- Add User role to the default tenant
INSERT INTO tenant_roles (tenant_id, role_id, role_name)
VALUES ('bad3c98b-e673-4547-bd3a-afe8f6fc5c68',
	(SELECT COALESCE(MAX(role_id), -1)+1 as new_role_id
	FROM tenant_roles
	WHERE tenant_id = 'bad3c98b-e673-4547-bd3a-afe8f6fc5c68'),
	'User');

-- Add the ADMIN_EPPN user to the default tenant
INSERT INTO tenant_users (tenant_id, user_id, tenant_role)
VALUES ('bad3c98b-e673-4547-bd3a-afe8f6fc5c68', 'notloggedin_admin_user_id', 0)
ON CONFLICT DO NOTHING;


-- Function to set tenant_id to current session's tenant_id
CREATE OR REPLACE FUNCTION set_tenant_id() RETURNS TRIGGER AS $$
BEGIN
    IF current_setting('site_session.tenant_id', true) IS NOT NULL THEN
        NEW.tenant_id := current_setting('site_session.tenant_id')::VARCHAR(36);
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE VIEW users_tenant_view AS
SELECT u.* FROM users u
INNER JOIN tenant_users tu ON u.id = tu.user_id
WHERE tu.tenant_id = current_setting('site_session.tenant_id')::VARCHAR(36)
GROUP BY u.id;

/*
INSTRUCTIONS FOR OBJECTS WITH TENANT SCOPE

These instructions are for objects that specifically exist on one tenant (i.e. Projects, API Keys)
    1. Add a column in the table of form:
        tenant_id VARCHAR(36) DEFAULT NULL REFERENCES tenants(id) ON DELETE CASCADE ON UPDATE CASCADE
    2. Add an index on this column for faster searching:
        CREATE INDEX IF NOT EXISTS idx_<YOUR_TABLE>_tenant_id
        ON <YOUR_TABLE>(tenant_id);
    3. Create a view for the object with tenant scope:
        CREATE OR REPLACE VIEW <YOUR_TABLE>_tenant_view AS
        SELECT * FROM <YOUR_TABLE>
        WHERE tenant_id = current_setting('site_session.tenant_id')::VARCHAR(36);
    4. Add the trigger to set tenant_id to current tenant on insert:
        CREATE OR REPLACE TRIGGER enforce_tenant_id
        BEFORE INSERT ON <YOUR_TABLE>
        FOR EACH ROW
        EXECUTE FUNCTION set_tenant_id();
    5. Replace instances of SELECT queries on <YOUR_TABLE> with <YOUR_TABLE>_tenant_view
       in the PHP model file. This includes wherever those tables are joined.

These instructions are for objects that can exist on mulitple tenants (i.e. Users)
    1. Make a link table like tenant_users
    2. Make a view like users_tenant_view
*/



COMMIT;

BEGIN;
