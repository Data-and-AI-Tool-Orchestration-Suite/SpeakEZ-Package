# ============================================================
# EXAMPLE FILE — cat-talk-jobs/.env
# Copy this file into the cat-talk-jobs folder, rename it to
# ".env", then fill in the two values.
# ============================================================

# 1 = this machine has a GPU and runs transcription jobs
#     (verbatimizer, synchronizer). Use this on the GPU machine.
# 0 = this machine has no GPU and runs analysis jobs
#     (custom, riskalyzer, describalizer, ohmsifier).
USE_GPU=1

# HuggingFace token (same token as in oral-transcription/.env).
HF_TOKEN=hf_CHANGE-ME-your-huggingface-token
