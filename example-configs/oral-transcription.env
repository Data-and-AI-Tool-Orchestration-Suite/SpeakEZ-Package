# ============================================================
# EXAMPLE FILE — oral-transcription/.env
# Copy this file into the oral-transcription folder, rename it
# to ".env", then paste your HuggingFace token.
# ============================================================

# A HuggingFace token (starts with hf_). Create a free account at
# https://huggingface.co , open Settings > Access Tokens, create a
# "read" token, then request access to these three model pages
# (click "Agree and access repository" on each):
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/wespeaker-voxceleb-resnet34-LM
HF_TOKEN=hf_CHANGE-ME-your-huggingface-token
