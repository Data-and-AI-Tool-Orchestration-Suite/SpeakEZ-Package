# ============================================================
# EXAMPLE FILE — CAT-Talk/.env
# Copy this file into the CAT-Talk folder, rename it to ".env",
# then replace every CHANGE-ME value with your real values.
# ============================================================

# The project name. Prefixes the container names. Leave as "speakez".
PROJECT_NAME=speakez

# Leave blank unless the site lives under a sub-path (rare).
ROOT_URL=

# The web port. The site will be at http://SERVER-IP:8080
APACHE_PORT=8080

# Database settings. Only change the password (pick a long random one).
POSTGRES_DB=speakez
POSTGRES_USER=speakez
POSTGRES_PASSWORD=CHANGE-ME-database-password
POSTGRES_PORT=5432

# The first admin account for the site (an email address).
# This must match the two places you edit in backend/postgres/init.sql
ADMIN_EPPN=daboyd2@uky.edu